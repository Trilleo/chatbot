# Copy to .env and fill in. .env is read by Docker Compose (variables for both
# containers) and by NoneBot when you run `uv run python bot.py` locally.
# The Docker image also ships this file as its list of known keys: NoneBot only
# reads a plugin's setting from an environment variable if the key appears in a
# dotenv file, so every new key belongs here (empty if it's a secret).
# Values are parsed as JSON where possible (lists: ["a", "b"]).

# ── QQ / NapCat ─────────────────────────────────────────────────────────────
# The bot's QQ account. NapCat uses it for quick login (no QR code after restarts).
QQ_ACCOUNT=
# Token for NapCat's WebUI (http://127.0.0.1:6099/webui, through an SSH tunnel).
# Applied only when NapCat's config volume is new; later, change it in the WebUI.
NAPCAT_WEBUI_TOKEN=

# ── NoneBot ─────────────────────────────────────────────────────────────────
DRIVER=~fastapi
# Local runs only; in Docker the bot always listens on 0.0.0.0:8080 inside its network.
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
# Shared secret for the NapCat → NoneBot reverse WebSocket. Required; generate one
# with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ONEBOT_ACCESS_TOKEN=
# QQ numbers allowed to run admin commands.
SUPERUSERS=[]
NICKNAME=[]
COMMAND_START=["/"]
COMMAND_SEP=["."]
# Local runs keep the database and other files in ./data, ./config and ./cache
# (the Docker image uses its /data volume instead).
LOCALSTORE_USE_CWD=true

# ── Plugins ─────────────────────────────────────────────────────────────────
# ping
PING_REPLY=pong

# llm_chat: chat with an LLM in private messages (friends only)
# Any OpenAI-compatible chat completions API; DeepSeek by default.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# Empty: the provider's default. DeepSeek ignores it while thinking is on.
LLM_TEMPERATURE=
# Output cap per reply; with thinking on it includes the reasoning.
LLM_MAX_TOKENS=8192
# Seconds per attempt, and retries on timeouts, rate limits and server errors.
LLM_TIMEOUT=120
LLM_MAX_RETRIES=1
# Extra JSON fields sent with each request. DeepSeek thinks by default (effort "high");
# e.g. {"reasoning_effort": "low"} for faster replies, or
# {"thinking": {"type": "disabled"}} to turn thinking off.
LLM_EXTRA_BODY={}
# Earlier messages sent with each request: at most this many, and about this many tokens.
LLM_CONTEXT_MAX_MESSAGES=20
LLM_CONTEXT_MAX_TOKENS=6000
# Longer messages are refused.
LLM_MAX_INPUT_CHARS=2000
# A file name in src/plugins/llm_chat/personas/ (without .md).
LLM_DEFAULT_PERSONA=default
# Replies longer than LLM_REPLY_MAX_CHARS go out as several messages, at most
# LLM_REPLY_MAX_PARTS (the rest is cut off).
LLM_REPLY_MAX_CHARS=300
LLM_REPLY_MAX_PARTS=5
# Random pauses in seconds (account safety): before the first message, counted from
# when the user's message arrived, and between the messages of a split reply.
LLM_FIRST_DELAY_MIN=1.0
LLM_FIRST_DELAY_MAX=3.0
LLM_PART_DELAY_MIN=1.0
LLM_PART_DELAY_MAX=3.0
