# Settings for the Docker image, loaded after .env because the image sets
# ENVIRONMENT=docker (NoneBot reads .env, then .env.{ENVIRONMENT}). Not for local runs.

# Everything the bot keeps (the SQLite database included) lives in the /data volume.
LOCALSTORE_DATA_DIR=/data
LOCALSTORE_CONFIG_DIR=/data/config
LOCALSTORE_CACHE_DIR=/tmp/cache

# Set from the image's GIT_SHA build argument.
STATUS_VERSION=dev
